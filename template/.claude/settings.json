{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git remote get-url *)",
      "Bash(bash -n *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit --no-verify *)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)"
    ]
  }
}
